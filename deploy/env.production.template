# Production — copy to server/.env on the host (DO NOT commit real secrets to git)

PORT=5000
NODE_ENV=production
MAX_VIDEO_UPLOAD_SIZE_MB=100
HISTORY_SHEET_MAX_UPLOAD_SIZE_MB=20
SYNOZA_HISTORY_SHEET_ROOT=/home/adminanmkavps/synoza-media/history-sheets
JWT_SECRET=CHANGE-TO-LONG-RANDOM-SECRET
JWT_EXPIRES_IN=7d
CLIENT_URL=https://synoza.anmka.com

# MySQL (cPanel) — URL-encode special chars in password (+ → %2B, = → %3D)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD_ENCODED@localhost:3306/DB_NAME"

AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-realtime-mini
OPENAI_WHISPER_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Gemini Live — Real-Time Voice-to-Voice OSCE (LIVE_VOICE sessions, 3 credits).
# The permanent API key NEVER leaves the server; clients receive single-use
# short-lived ephemeral tokens minted at /api/sessions/:id/live-voice/token.
GEMINI_API_KEY=your-gemini-api-key
# Optional distinct Gemini Live voices so the patient and the examiner sound
# different (e.g. Aoede, Kore, Puck, Charon). Leave empty to use the default.
GEMINI_LIVE_PATIENT_VOICE=
GEMINI_LIVE_EXAMINER_VOICE=

ADMIN_EMAIL=admin@synoza.com
ADMIN_PASSWORD=ChangeMeAfterDeploy

# SMTP (signup OTP verification)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=app@anmka.com
SMTP_PASS=CHANGE-SMTP-PASSWORD
SMTP_FROM=app@anmka.com
SMTP_FROM_NAME=Synoza

# Payment — Paymob Accept
PAYMENT_PROVIDER=paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP

# Payment — Kashier / كاشير
# Set PAYMENT_PROVIDER=kashier and fill the three Kashier keys below to use it.
# Real values live in deploy/server.env.production (gitignored) / the live server .env.
KASHIER_MID=MID-XXXXX-XXX
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MODE=live
KASHIER_CURRENCY=EGP
KASHIER_ALLOWED_METHODS=card,wallet,bank_installments
PAYMENT_CALLBACK_BASE_URL=https://synozaa.com
